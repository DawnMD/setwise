DATABASE_URL="postgresql://user:password@host/db"
DATABASE_URL_UNPOOLED="postgresql://user:password@host-unpooled/db"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
# Local auth origin. Vercel deployments are discovered from Vercel's system
# environment variables instead, so this does not need a deployment override.
BETTER_AUTH_URL="http://localhost:3000"

# Rollback switches for the performance work. All default to on; set one to "0"
# to restore the behaviour that shipped before it. See docs/performance.md.
# VITE_CACHE_PATCHING="0"      # invalidate and refetch after every write
# BETTER_AUTH_COOKIE_CACHE="0" # resolve the session from the database each time
