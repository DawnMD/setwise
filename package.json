{
  "name": "setwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@setwise/web",
    "dev:mobile": "turbo run dev --filter=@setwise/mobile",
    "dev:android": "node scripts/dev-android.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "boundaries": "node scripts/check-boundaries.mjs",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run format:check boundaries lint typecheck test build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "turbo": "2.10.11"
  }
}
